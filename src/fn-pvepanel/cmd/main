#!/bin/bash
### PVE 面板 lifecycle: start / stop / status
###
### Notes that cost time to learn the hard way:
###   * setsid is required, otherwise the child dies when appcenter finishes
###     calling us and the panel never comes up.
###   * the poll loop must actually wait for the port. Returning 0 early makes
###     install_callback announce a desktop entry that cannot be opened yet.
###   * status must use 0 = running / 3 = stopped; any other code is read by
###     the app centre as "unknown" and the app shows as neither state.
set -u

PKG_VAR="${TRIM_PKGVAR:-/tmp/pvepanel-var}"
APP_HOME="${TRIM_APPDEST:-}"
PID_FILE="${PKG_VAR}/pvepanel.pid"
LOG_FILE="${PKG_VAR}/pvepanel.log"
PORTS_FILE="${PKG_VAR}/runtime-ports.env"
# The default port is randomised on purpose. A fixed port would be the same on
# every installation on the same network segment, so a scan of the LAN finds the
# panel, and two fnOS boxes would fight over it. A random free port in
# 20000-59999 is picked at first start and remembered in runtime-ports.env, so
# it stays stable across restarts.
PORT_FILE="${PKG_VAR}/backend-port"
DEFAULT_PORT=""

mkdir -p "${PKG_VAR}" 2>/dev/null || true

pick_random_port() {
    # A port that is free right now, unprivileged, and away from the usual
    # defaults (8006 pveproxy, 8080, 8888, 9090, 8899 ...).
    #
    # awk's srand() with no argument seeds from the clock in WHOLE seconds, so
    # two runs in the same second produce the same "random" port; a fresh
    # install then lands on the old one, which is exactly the collision this is
    # meant to avoid. Seed explicitly from pid+nanoseconds, and also refuse to
    # hand back the value the previous start used.
    local tries=0 candidate previous=""
    if [ -r "${PORT_FILE}" ]; then
        previous="$(tr -dc '0-9' < "${PORT_FILE}" 2>/dev/null)"
    fi
    while [ "${tries}" -lt 80 ]; do
        candidate="$(awk -v seed="$-$(date +%s%N)-${tries}" '
            BEGIN {
                s = 0
                for (i = 1; i <= length(seed); i++) s = (s * 31 + index("0123456789-", substr(seed, i, 1))) % 1000003
                srand(s)
                printf "%d", 20000 + int(rand() * 40000)
            }')"
        case "${candidate}" in
            ''|*[!0-9]*) candidate="" ;;
        esac
        if [ -n "${candidate}" ] && [ "${candidate}" != "${previous}" ] \
           && ! (exec 3<>"/dev/tcp/127.0.0.1/${candidate}") 2>/dev/null; then
            printf '%s\n' "${candidate}"
            return 0
        fi
        exec 3<&- 3>&- 2>/dev/null || true
        tries=$((tries + 1))
        sleep 0.05 2>/dev/null || true
    done
    printf '%s\n' "24189"
}

# The port is chosen once and then remembered.
#
# wizard_backend_port is deliberately NOT consulted, even though the install
# wizard used to set it: appcenter replays the install-time answer on every
# start (verified by wrapping cmd/main and dumping env), so honouring it would
# freeze the very first port forever - deleting the remembered file could not
# change it. Only an explicit BACKEND_PORT pins the port, which is what
# tools/deploy.py --env uses for a reproducible deployment.
if [ -n "${BACKEND_PORT:-}" ] && [ "${BACKEND_PORT}" != "0" ]; then
    PORT="${BACKEND_PORT}"
elif [ -r "${PORT_FILE}" ] && [ -s "${PORT_FILE}" ]; then
    PORT="$(cat "${PORT_FILE}" 2>/dev/null | tr -dc '0-9')"
else
    PORT="$(pick_random_port)"
fi

# An empty or nonsense port falls back to a fresh random one rather than 8899.
case "${PORT}" in
    ''|*[!0-9]*) PORT="$(pick_random_port)" ;;
esac
if [ "${PORT}" -lt 1024 ] || [ "${PORT}" -gt 65535 ]; then
    PORT="$(pick_random_port)"
fi

SERVER="${APP_HOME}/server/pvepanel.py"

find_python() {
    local c
    for c in /usr/bin/python3 /usr/local/bin/python3 /bin/python3; do
        if [ -x "${c}" ]; then printf '%s\n' "${c}"; return 0; fi
    done
    if command -v python3 >/dev/null 2>&1; then command -v python3; return 0; fi
    return 1
}

PYTHON="$(find_python || true)"

MANIFEST_FILE="$(dirname "$0")/../manifest"
APP_VERSION=""
if [ -r "${MANIFEST_FILE}" ]; then
    APP_VERSION="$(grep -E '^version' "${MANIFEST_FILE}" | head -1 | cut -d= -f2 | tr -d ' \t\r')"
fi
[ -n "${APP_VERSION}" ] || APP_VERSION="26.11.0"

warn() {
    if [ -n "${TRIM_TEMP_LOGFILE:-}" ]; then
        printf '%s\n' "$1" > "${TRIM_TEMP_LOGFILE}" 2>/dev/null || true
    fi
    printf '%s\n' "$1" >&2
}

read_pid() {
    if [ -f "${PID_FILE}" ]; then
        cat "${PID_FILE}" 2>/dev/null || true
    fi
}

is_running() {
    local pid
    pid="$(read_pid)"
    [ -n "${pid}" ] || return 1
    kill -0 "${pid}" 2>/dev/null
}

port_ready() {
    if (exec 3<>"/dev/tcp/127.0.0.1/${PORT}") 2>/dev/null; then
        exec 3<&- 3>&- 2>/dev/null || true
        return 0
    fi
    return 1
}

write_runtime_ports() {
    {
        printf 'BACKEND_PORT=%s\n' "${PORT}"
        printf 'ADMIN_TARGET_PORT=%s\n' "${PORT}"
        printf 'ADMIN_TARGET_HOST=127.0.0.1\n'
    } > "${PORTS_FILE}" 2>/dev/null || true
    chmod 600 "${PORTS_FILE}" 2>/dev/null || true
}

rotate_log() {
    if [ -f "${LOG_FILE}" ]; then
        local size
        size="$(wc -c < "${LOG_FILE}" 2>/dev/null || echo 0)"
        if [ "${size}" -gt 1048576 ]; then
            mv -f "${LOG_FILE}" "${LOG_FILE}.1" 2>/dev/null || true
        fi
    fi
}

start() {
    if is_running; then
        # Already up. Touch NOTHING: whatever is in PORT_FILE was written by the
        # run that is currently serving, and recomputing it here is how the file
        # and the live socket drifted apart (index.cgi then forwarded to a dead
        # port while the service itself was perfectly healthy).
        return 0
    fi

    if [ -z "${APP_HOME}" ]; then
        warn "TRIM_APPDEST 为空，无法定位 PVE 面板程序目录。"
        return 1
    fi
    if [ ! -f "${SERVER}" ]; then
        warn "找不到服务文件：${SERVER}"
        return 1
    fi
    if [ -z "${PYTHON}" ]; then
        warn "未找到 python3。PVE 面板依赖系统自带的 Python 3。"
        return 1
    fi

    rotate_log
    # Written here and nowhere else: from this moment PORT_FILE describes the
    # process that is about to start.
    printf '%s\n' "${PORT}" > "${PORT_FILE}" 2>/dev/null || true
    chmod 600 "${PORT_FILE}" 2>/dev/null || true
    write_runtime_ports

    cd "${APP_HOME}/server" || return 1
    # The panel listens on loopback on purpose: the desktop entry reaches it
    # through index.cgi, which is gated by the fnOS login. The raw port is not.
    TRIM_PKGVAR="${PKG_VAR}" \
    PVEPANEL_PORT="${PORT}" \
    PVEPANEL_VERSION="${APP_VERSION}" \
    PVEPANEL_APP_HOME="${APP_HOME}" \
    BACKEND_PORT="${PORT}" \
    PVEPANEL_LISTEN="127.0.0.1" \
    setsid "${PYTHON}" "${SERVER}" >> "${LOG_FILE}" 2>&1 < /dev/null &
    echo $! > "${PID_FILE}"

    local i=0
    while [ "${i}" -lt 40 ]; do
        if ! is_running; then
            warn "PVE 面板进程启动后立即退出，请查看 ${LOG_FILE}。"
            rm -f "${PID_FILE}"
            return 1
        fi
        if port_ready; then
            return 0
        fi
        sleep 0.5
        i=$((i + 1))
    done

    warn "PVE 面板在 20 秒内未开始监听端口 ${PORT}。"
    return 1
}


stop() {
    local pid
    pid="$(read_pid)"
    if [ -n "${pid}" ] && kill -0 "${pid}" 2>/dev/null; then
        kill "${pid}" 2>/dev/null || true
        local i=0
        while [ "${i}" -lt 30 ] && kill -0 "${pid}" 2>/dev/null; do
            sleep 0.5
            i=$((i + 1))
        done
        if kill -0 "${pid}" 2>/dev/null; then
            kill -9 "${pid}" 2>/dev/null || true
        fi
    fi
    # A pid file can be lost while the process keeps running (for example when
    # the app is reinstalled while it is up). Sweep our own service file so a
    # stale process cannot hold the old port and make `status` lie.
    local stray
    stray="$(pgrep -f "${APP_HOME}/server/pvepanel.py" 2>/dev/null || true)"
    if [ -n "${stray}" ]; then
        # shellcheck disable=SC2086
        kill ${stray} 2>/dev/null || true
        sleep 1
        # shellcheck disable=SC2086
        kill -9 ${stray} 2>/dev/null || true
    fi
    rm -f "${PID_FILE}" 2>/dev/null || true
    return 0
}

status() {
    if is_running; then return 0; fi
    if port_ready; then return 0; fi
    return 3
}

rc=0
case "${1:-}" in
    start)   start || rc=$? ;;
    stop)    stop || rc=$? ;;
    status)  status || rc=$? ;;
    restart) stop || true; sleep 1; start || rc=$? ;;
    *)
        echo "usage: $0 {start|stop|status|restart}"
        rc=1
        ;;
esac

exit "${rc}"